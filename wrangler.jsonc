{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aduana-ia-fork",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
