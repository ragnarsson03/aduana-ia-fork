{
  "name": "aduana-ia-fork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prueba base React + Vite + TypeScript + Cloudflare Workers (Static Assets) para Aduana IA.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "dev:cf": "wrangler dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragnarsson03/aduana-ia-fork.git"
  },
  "keywords": [
    "ai-governance",
    "cloudflare-workers",
    "react",
    "typescript"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.14.0"
  }
}
